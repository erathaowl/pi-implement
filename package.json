{
  "name": "pi-implement",
  "version": "0.1.0",
  "description": "A minimal pi extension for sequentially implementing tasks from Markdown files",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erathaowl/pi-implement.git"
  },
  "homepage": "https://github.com/erathaowl/pi-implement#readme",
  "bugs": {
    "url": "https://github.com/erathaowl/pi-implement/issues"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
